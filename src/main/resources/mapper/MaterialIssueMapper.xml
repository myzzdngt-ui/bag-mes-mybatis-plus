<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bagmes.mapper.MaterialIssueMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.bagmes.entity.MaterialIssue">
        <id column="issue_id" property="issueId" />
        <result column="work_order_id" property="workOrderId" />
        <result column="material_id" property="materialId" />
        <result column="issue_type" property="issueType" />
        <result column="qty" property="qty" />
        <result column="operator_id" property="operatorId" />
        <result column="issue_time" property="issueTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        issue_id, work_order_id, material_id, issue_type, qty, operator_id, issue_time
    </sql>

</mapper>
