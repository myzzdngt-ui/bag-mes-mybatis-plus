<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bagmes.mapper.ProductionReportMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.bagmes.entity.ProductionReport">
        <id column="report_id" property="reportId" />
        <id column="report_time" property="reportTime" />
        <result column="report_event_id" property="reportEventId" />
        <result column="work_order_id" property="workOrderId" />
        <result column="operation_id" property="operationId" />
        <result column="input_qty" property="inputQty" />
        <result column="good_qty" property="goodQty" />
        <result column="rework_qty" property="reworkQty" />
        <result column="scrap_qty" property="scrapQty" />
        <result column="operator_id" property="operatorId" />
        <result column="batch_no" property="batchNo" />
        <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        report_id, report_event_id, work_order_id, operation_id, report_time, input_qty, good_qty, rework_qty, scrap_qty, operator_id, batch_no, remark
    </sql>

</mapper>
