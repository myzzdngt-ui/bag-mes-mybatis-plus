<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bagmes.mapper.TraceLinkMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.bagmes.entity.TraceLink">
        <id column="trace_id" property="traceId" />
        <result column="source_type" property="sourceType" />
        <result column="source_id" property="sourceId" />
        <result column="target_type" property="targetType" />
        <result column="target_id" property="targetId" />
        <result column="link_qty" property="linkQty" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        trace_id, source_type, source_id, target_type, target_id, link_qty, created_at
    </sql>

</mapper>
